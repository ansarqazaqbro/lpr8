meta {
  name: 2. Create Dish (Valid)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/dishes
  body: json
  auth: none
}

body:json {
  {
    "menu_section_id": 1,
    "name": "Тестовое блюдо Bruno",
    "description": "Описание блюда для теста API",
    "weight_g": 350,
    "price": 2500.00,
    "calories": 450,
    "is_vegan": true
  }
}

script:post-response {
  if (res.status === 201) {
    const data = res.getBody();
    if (data && data.payload && data.payload.id) {
      bru.setEnvVar("item_id", data.payload.id);
    }
  }
}
